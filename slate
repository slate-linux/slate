#!/bin/bash
set -o pipefail

export PORTS_DIR="/usr/ports"
STAGE_PARENT="${SLATE_TMPDIR:-/var/tmp}"

STAGE=""
MANIFEST_TMP=""
UPDATE_WORK=""
SILENT=0
VERBOSE=0
NO_DEPS=0
FORCE=0
INFO=0
SHOW_DEPS=0

declare -A DEPENDENCY_VISITING=()
declare -A DEPENDENCY_DONE=()

die() {
    echo "slate: $*" >&2
    exit 1
}

say() {
    [ "$SILENT" -eq 1 ] || echo "$@"
}

usage_text() {
    echo "Usage:"
    echo "  slate [options] install <category>/<package>"
    echo "  slate [options] uninstall [--force] <category>/<package>"
    echo "  slate [options] upgrade [<category>/<package>]"
    echo "  slate [options] installed"
    echo "  slate [options] list [<category>]"
    echo "  slate [options] update"
    echo "  slate [options] update-version"
    echo "  slate [options] --clean"
    echo ""
    echo "Options:"
    echo "  -S, --sysroot DIR   Use alternate sysroot"
    echo "  -i                  Show package information"
    echo "  -d                  Show package dependencies"
    echo "  -v                  Verbose build output"
    echo "  -n                  Do not install dependencies"
    echo "  -f, --force         Force operation"
    echo "  -s, --silent        Suppress build output"
    echo "  --clean             Remove temporary Slate files"
}

usage() {
    usage_text
    exit 1
}

if [ $# -eq 0 ]; then
    usage_text
    exit 0
fi

# --------------------------------------------------
# Argument parsing
# --------------------------------------------------

SYSROOT="/"
ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --sysroot|-S)
            [ -n "$2" ] || usage
            SYSROOT="$2"
            shift 2
            ;;
        --sysroot=*)
            SYSROOT="${1#--sysroot=}"
            shift
            ;;
        --force|-f)
            FORCE=1
            shift
            ;;
        --silent|-s)
            SILENT=1
            shift
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -n|--no-deps)
            NO_DEPS=1
            shift
            ;;
        -i|--info)
            INFO=1
            shift
            ;;
        -d|--dependencies)
            SHOW_DEPS=1
            shift
            ;;
        --clean)
            ARGS+=("--clean")
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

set -- "${ARGS[@]}"

SYSROOT="${SYSROOT%/}"
[ -n "$SYSROOT" ] || SYSROOT="/"

if [ "$SYSROOT" != "/" ]; then
    case "$SYSROOT" in
        /*) ;;
        *) die "sysroot must be an absolute path: $SYSROOT" ;;
    esac
    mkdir -p "$SYSROOT"
fi

export SLATE_SYSROOT="$SYSROOT"

STATE_DIR="${SYSROOT%/}/var/lib/slate/installed"
MANIFEST_DIR="${SYSROOT%/}/var/lib/slate/manifests"
LOG_DIR="${SYSROOT%/}/var/log/slate"

# --------------------------------------------------
# Build options
# --------------------------------------------------

MAKEOPTS_FILE="$SYSROOT/etc/slate.conf/makeopts"
MAKETHREADS=1

if [ -e "$MAKEOPTS_FILE" ] && [ ! -r "$MAKEOPTS_FILE" ]; then
    die "cannot read $MAKEOPTS_FILE"
fi

if [ -r "$MAKEOPTS_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"

        [[ "$line" =~ ^[[:space:]]*$ ]] && continue

        if [[ "$line" =~ ^[[:space:]]*MAKETHREADS[[:space:]]*=[[:space:]]*(.*)$ ]]; then
            value="${BASH_REMATCH[1]}"

            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"

            if [[ "$value" == \"*\" ]]; then
                value="${value#\"}"
                value="${value%\"}"
            elif [[ "$value" == \'*\' ]]; then
                value="${value#\'}"
                value="${value%\'}"
            fi

            [[ "$value" =~ ^[1-9][0-9]*$ ]] ||
                die "$MAKEOPTS_FILE: invalid MAKETHREADS value: '$value'"

            MAKETHREADS="$value"
        fi
    done < "$MAKEOPTS_FILE"
fi

export MAKETHREADS

# --------------------------------------------------
# General helpers
# --------------------------------------------------

check_name() {
    [[ "$1" =~ ^[a-zA-Z0-9._+-]+/[a-zA-Z0-9._+-]+$ ]] ||
        die "invalid port name: $1"
}

require_root() {
    if [ "$SYSROOT" = "/" ] && [ "$EUID" -ne 0 ]; then
        die "$1 requires root privileges"
    fi
}

get_installed_version() {
    local manifest="$MANIFEST_DIR/$1"

    [ -f "$manifest" ] || return 0

    sed -n 's/^# VERSION=//p' "$manifest" | head -n 1
}

# --------------------------------------------------
# Package metadata
# --------------------------------------------------

read_meta() {
    local meta="$1"
    local line value

    PACKAGE_VERSION=""
    PACKAGE_DEPENDS=()

    [ -f "$meta" ] || die "missing meta.conf: $meta"

    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"

        if [[ "$line" =~ ^[[:space:]]*VERSION[[:space:]]*=[[:space:]]*(.*)$ ]]; then
            value="${BASH_REMATCH[1]}"

            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"

            if [[ "$value" == \"* ]]; then
                value="${value#\"}"
                value="${value%\"}"
            elif [[ "$value" == \'* ]]; then
                value="${value#\'}"
                value="${value%\'}"
            fi

            PACKAGE_VERSION="$value"

        elif [[ "$line" =~ ^[[:space:]]*DEPENDS[[:space:]]*=[[:space:]]*(.*)$ ]]; then
            value="${BASH_REMATCH[1]}"

            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"

            if [[ "$value" == \"* ]]; then
                value="${value#\"}"
                value="${value%\"}"
            elif [[ "$value" == \'* ]]; then
                value="${value#\'}"
                value="${value%\'}"
            fi

            PACKAGE_DEPENDS=()

            if [ -n "$value" ]; then
                read -r -a PACKAGE_DEPENDS <<< "$value"
            fi
        fi
    done < "$meta"

    [[ "$PACKAGE_VERSION" =~ ^[0-9]+(\.[0-9]+)+$ ]] ||
        die "$meta: invalid or missing VERSION"

    local dep

    for dep in "${PACKAGE_DEPENDS[@]}"; do
        [[ "$dep" =~ ^[a-zA-Z0-9._+-]+/[a-zA-Z0-9._+-]+$ ]] ||
            die "$meta: invalid dependency '$dep'"
    done
}

# --------------------------------------------------
# Package information
# --------------------------------------------------

package_info() {
    local name="$1"
    local meta="$PORTS_DIR/$name/meta.conf"
    local installed_version

    check_name "$name"
    [ -f "$meta" ] || die "package not found: $name"

    read_meta "$meta"

    installed_version=$(get_installed_version "$name")

    echo "Package: ${name##*/}"
    echo "Category: ${name%%/*}"
    echo "Version: $PACKAGE_VERSION"

    if [ -n "$installed_version" ]; then
        echo "Installed: yes ($installed_version)"
    else
        echo "Installed: no"
    fi

    echo "Dependencies:"

    if [ "${#PACKAGE_DEPENDS[@]}" -eq 0 ]; then
        echo "  None"
    else
        local dep
        for dep in "${PACKAGE_DEPENDS[@]}"; do
            if [ -f "$STATE_DIR/$dep" ]; then
                echo "  $dep (installed)"
            else
                echo "  $dep (not installed)"
            fi
        done
    fi
}

package_dependencies() {
    local name="$1"
    local dep

    check_name "$name"

    [ -f "$PORTS_DIR/$name/meta.conf" ] ||
        die "package not found: $name"

    read_meta "$PORTS_DIR/$name/meta.conf"

    if [ "${#PACKAGE_DEPENDS[@]}" -eq 0 ]; then
        echo "$name has no dependencies."
        return 0
    fi

    echo "Dependencies for $name:"

    for dep in "${PACKAGE_DEPENDS[@]}"; do
        if [ -f "$STATE_DIR/$dep" ]; then
            echo "  $dep (installed)"
        else
            echo "  $dep (not installed)"
        fi
    done
}

# --------------------------------------------------
# Manifest handling
# --------------------------------------------------

write_manifest() {
    {
        printf '# PACKAGE=%s\n' "$3"
        printf '# VERSION=%s\n' "$4"

        (
            cd "$1" &&
            find . -mindepth 1 -print0
        ) |
        while IFS= read -r -d '' entry; do
            rel="${entry#./}"
            src="$1/$rel"

            if [ -L "$src" ]; then
                printf 'l\t-\t%s\n' "$rel"

            elif [ -d "$src" ]; then
                if [ ! -e "$SYSROOT/$rel" ] && [ ! -L "$SYSROOT/$rel" ]; then
                    printf 'd\t-\t%s\n' "$rel"
                fi

            elif [ -f "$src" ]; then
                sum=$(sha256sum -- "$src" | cut -d' ' -f1)
                printf 'f\t%s\t%s\n' "$sum" "$rel"
            fi
        done | sort -t$'\t' -k3,3

    } > "$2"
}

transplant() {
    cp -a "$1"/. "$SYSROOT"/
}

remove_manifest() {
    while IFS=$'\t' read -r type _ rel; do
        case "$type" in
            f|l)
                rm -f -- "$SYSROOT/$rel"
                ;;
            d)
                ;;
        esac
    done < "$1"

    awk -F'\t' '$1 == "d" { print $3 }' "$1" |
        sort -r |
        while IFS= read -r rel; do
            rmdir -- "$SYSROOT/$rel" 2>/dev/null
        done

    return 0
}

cleanup_install() {
    [ -n "$STAGE" ] && [ -d "$STAGE" ] && rm -rf -- "$STAGE"
    [ -n "$MANIFEST_TMP" ] && [ -f "$MANIFEST_TMP" ] && rm -f -- "$MANIFEST_TMP"

    STAGE=""
    MANIFEST_TMP=""
}

cleanup_update() {
    [ -n "$UPDATE_WORK" ] && [ -d "$UPDATE_WORK" ] && rm -rf -- "$UPDATE_WORK"
}

# --------------------------------------------------
# Install one package
# --------------------------------------------------

install_one() {
    local PORT_NAME="$1"
    local PACKAGE_VERSION="$2"

    local PORT_DIR="$PORTS_DIR/$PORT_NAME"
    local PORT_SCRIPT="$PORT_DIR/port.sh"
    local LOG_FILE
    local result
    local count

    say "==> Installing $PORT_NAME ($PACKAGE_VERSION)"
    say "==> Port directory: $PORT_DIR"
    say "==> Build threads: $MAKETHREADS"

    [ "$SYSROOT" = "/" ] || say "==> Target sysroot: $SYSROOT"

    mkdir -p "$LOG_DIR" "$STAGE_PARENT" ||
        die "cannot create $STAGE_PARENT"

    STAGE=$(mktemp -d "$STAGE_PARENT/slate-stage.XXXXXX") ||
        die "cannot create staging root"

    MANIFEST_TMP=$(mktemp "$STAGE_PARENT/slate-manifest.XXXXXX") ||
        die "cannot create manifest"

    trap cleanup_install EXIT

    LOG_FILE="$LOG_DIR/${PORT_NAME//\//_}.log"

    if [ "$SILENT" -eq 1 ]; then
        (
            cd "$PORT_DIR" &&
            PORT_NAME="$PORT_NAME" \
	    PORTS_DIR="$PORTS_DIR" \
            PORT_DIR="$PORT_DIR" \
	    VERSION="$PACKAGE_VERSION" \
            DESTDIR="$STAGE" \
            MAKETHREADS="$MAKETHREADS" \
            bash "$PORT_SCRIPT"
        ) > "$LOG_FILE" 2>&1

    elif [ "$VERBOSE" -eq 1 ]; then
        (
            cd "$PORT_DIR" &&
            PORT_NAME="$PORT_NAME" \
            PORT_DIR="$PORT_DIR" \
	    PORTS_DIR="$PORT_DIR" \
	    VERSION="$PACKAGE_VERSION" \
            DESTDIR="$STAGE" \
            MAKETHREADS="$MAKETHREADS" \
            bash -x "$PORT_SCRIPT"
        )

    else
        (
            cd "$PORT_DIR" &&
            PORT_NAME="$PORT_NAME" \
            PORT_DIR="$PORT_DIR" \
	    VERSION="$PACKAGE_VERSION" \
	    PORTS_DIR="$PORTS_DIR"
            DESTDIR="$STAGE" \
            MAKETHREADS="$MAKETHREADS" \
            bash "$PORT_SCRIPT"
        )
    fi

    result=$?

    if [ "$result" -ne 0 ]; then
        echo "==> Failed to install $PORT_NAME; nothing was copied into $SYSROOT" >&2
        [ "$SILENT" -eq 1 ] && echo "slate: see $LOG_FILE" >&2
        return "$result"
    fi

    if [ -z "$(find "$STAGE" -mindepth 1 -print -quit)" ]; then
        die "$PORT_NAME installed no files"
    fi

    write_manifest "$STAGE" "$MANIFEST_TMP" \
        "$PORT_NAME" "$PACKAGE_VERSION"

    say "> Copying files into $SYSROOT"

    transplant "$STAGE" || {
        echo "slate: copy failed; some files may be partly copied into $SYSROOT" >&2
        return 1
    }

    mkdir -p \
        "$(dirname "$MANIFEST_DIR/$PORT_NAME")" \
        "$(dirname "$STATE_DIR/$PORT_NAME")"

    chmod 644 "$MANIFEST_TMP"

    mv -f "$MANIFEST_TMP" "$MANIFEST_DIR/$PORT_NAME"

    date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE_DIR/$PORT_NAME"

    count=$(grep -c '^[fl]' "$MANIFEST_DIR/$PORT_NAME")

    say "> Finished installing $PORT_NAME ($PACKAGE_VERSION, $count files)"

    cleanup_install
    trap - EXIT

    return 0
}

# --------------------------------------------------
# Dependency resolution
# --------------------------------------------------

install_package() {
    local name="$1"
    local dep
    local port_dir
    local version
    local installed_version

    local -a dependencies=()

    check_name "$name"

    port_dir="$PORTS_DIR/$name"

    [ -d "$port_dir" ] ||
        die "package not found: $name"

    [ -f "$port_dir/port.sh" ] ||
        die "missing port.sh in $name"

    read_meta "$port_dir/meta.conf"

    version="$PACKAGE_VERSION"
    dependencies=("${PACKAGE_DEPENDS[@]}"

    )

    installed_version=$(get_installed_version "$name")

    if [ -n "$installed_version" ] && [ "$UPGRADE_MODE" -eq 0 ]; then
        say "==> $name is already installed"
        DEPENDENCY_DONE["$name"]=1
        return 0
    fi

    if [ -n "$installed_version" ] && [ "$installed_version" = "$version" ]; then
        say "==> $name is already up to date ($version)"
        DEPENDENCY_DONE["$name"]=1
        return 0
    fi

    if [ "${DEPENDENCY_VISITING[$name]:-0}" = 1 ]; then
        die "circular dependency detected involving $name"
    fi

    if [ "${DEPENDENCY_DONE[$name]:-0}" = 1 ]; then
        return 0
    fi

    DEPENDENCY_VISITING["$name"]=1

    if [ "$NO_DEPS" -eq 0 ]; then
        for dep in "${dependencies[@]}"; do
            say "==> Resolving dependency: $dep"
            install_package "$dep" || return 1
        done
    fi

    unset 'DEPENDENCY_VISITING[$name]'

    install_one "$name" "$version" || return 1

    DEPENDENCY_DONE["$name"]=1

    return 0
}

# --------------------------------------------------
# Repository helpers
# --------------------------------------------------

channel_to_ref() {
    local tag="$1"

    if [[ "${tag,,}" == "testing" ]]; then
        echo "main"
    elif [[ "$tag" =~ ^v?[0-9]+(\.[0-9]+)*$ ]]; then
        echo "$tag"
    else
        return 1
    fi
}

VER_FILE="${SLATE_VER_FILE:-/etc/slate.conf/ver}"
CURRENT_VERSION=""

read_current_version() {
    local v=""

    [ -n "$CURRENT_VERSION" ] && return 0

    [ -r "$VER_FILE" ] ||
        die "cannot read current version from $VER_FILE"

    read -r v < "$VER_FILE" || true

    v="${v%%#*}"
    v="${v//$'\r'/}"
    v="${v//[[:space:]]/}"

    [[ "$v" =~ ^[0-9]+(\.[0-9]+)*$ ]] ||
        die "$VER_FILE: invalid version '$v'"

    CURRENT_VERSION="$v"
}

load_repos() {
    REPOS_FILE="${SLATE_REPOS_FILE:-/etc/slate.conf/repos}"

    [ -r "$REPOS_FILE" ] ||
        die "cannot read repository list from $REPOS_FILE"

    REPO_URLS=()
    REPO_TAGS=()
    REPO_REFS=()

    local lineno=0 line url tag ref

    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))

        line="${line%%#*}"
        line="${line//$'\r'/}"

        url=""
        tag=""

        read -r url tag _ <<< "$line"

        [ -n "$url" ] || continue

        tag="${tag//[\"\']/}"

        [[ "$url" =~ ^(https?|git|ssh)://[^[:space:]]+$ ]] ||
            die "$REPOS_FILE:$lineno: invalid repository URL: '$url'"

        [ -n "$tag" ] ||
            die "$REPOS_FILE:$lineno: missing release"

        if [[ "${tag,,}" == "current" ]]; then
            read_current_version
            tag="$CURRENT_VERSION"
        fi

        ref=$(channel_to_ref "$tag") ||
            die "$REPOS_FILE:$lineno: invalid release '$tag'"

        REPO_URLS+=("$url")
        REPO_TAGS+=("$tag")
        REPO_REFS+=("$ref")
    done < "$REPOS_FILE"

    [ "${#REPO_URLS[@]}" -gt 0 ] ||
        die "no repositories listed in $REPOS_FILE"
}

# --------------------------------------------------
# Commands
# --------------------------------------------------

UPGRADE_MODE=0

case "$1" in

    # ==============================================
    # PACKAGE INFORMATION
    # ==============================================

    info)
        [ -n "$2" ] || usage
        package_info "$2"
        ;;

    dependencies)
        [ -n "$2" ] || usage
        package_dependencies "$2"
        ;;

    # ==============================================
    # INSTALL
    # ==============================================

    install)
        [ -n "$2" ] || usage

        require_root installation

        DEPENDENCY_VISITING=()
        DEPENDENCY_DONE=()

        install_package "$2"
        ;;

    # ==============================================
    # UPGRADE
    # ==============================================

    upgrade)
        require_root upgrade

        UPGRADE_MODE=1

        DEPENDENCY_VISITING=()
        DEPENDENCY_DONE=()

        if [ -n "$2" ]; then
            install_package "$2"
        else
            [ -d "$STATE_DIR" ] || die "no installed packages found"

            while IFS= read -r file; do
                name="${file#"$STATE_DIR"/}"

                install_package "$name" || die "failed to upgrade $name"
            done < <(find "$STATE_DIR" -type f | sort)
        fi
        ;;

    # ==============================================
    # UNINSTALL
    # ==============================================

    uninstall)
        [ -n "$2" ] || usage

        PORT_NAME="$2"
        check_name "$PORT_NAME"

        require_root uninstallation

        [ -f "$STATE_DIR/$PORT_NAME" ] ||
            die "$PORT_NAME is not installed in $SYSROOT"

        MANIFEST="$MANIFEST_DIR/$PORT_NAME"

        [ -f "$MANIFEST" ] ||
            die "no file manifest for $PORT_NAME; remove it by hand"

        modified=$(
            while IFS=$'\t' read -r type sum rel; do
                [ "$type" = f ] || continue
                [ -f "$SYSROOT/$rel" ] || continue

                cur=$(sha256sum -- "$SYSROOT/$rel" | cut -d' ' -f1)

                [ "$cur" = "$sum" ] || echo "  /$rel"
            done < "$MANIFEST"
        )

        if [ -n "$modified" ] && [ "$FORCE" -ne 1 ]; then
            echo "slate: these files changed since $PORT_NAME was installed:" >&2
            echo "$modified" >&2
            die "refusing to uninstall; rerun with --force"
        fi

        say "==> Uninstalling $PORT_NAME"

        remove_manifest "$MANIFEST"

        rm -f -- "$MANIFEST" "$STATE_DIR/$PORT_NAME"

        rmdir \
            "$(dirname "$MANIFEST")" \
            "$(dirname "$STATE_DIR/$PORT_NAME")" \
            2>/dev/null

        say "> Finished uninstalling $PORT_NAME"
        ;;

    # ==============================================
    # INSTALLED
    # ==============================================

    installed)
        [ -d "$STATE_DIR" ] || exit 0

        while IFS= read -r f; do
            name="${f#"$STATE_DIR"/}"
            version=$(get_installed_version "$name")
            [ -n "$version" ] || version="unknown"

            printf '%-30s %s\n' "$name" "$version"
        done < <(find "$STATE_DIR" -type f | sort)
        ;;

    # ==============================================
    # CLEAN
    # ==============================================

    --clean)
        require_root cleanup

        say "==> Cleaning Slate temporary files"

        find "$STAGE_PARENT" -maxdepth 1 -type d \
            \( -name 'slate-stage.*' -o -name '.slate-update.*' \) \
            -exec rm -rf -- {} +

        find "$STAGE_PARENT" -maxdepth 1 -type f \
            -name 'slate-manifest.*' \
            -delete

        say "> Cleanup complete"
        ;;

    # ==============================================
    # UPDATE REPOSITORIES
    # ==============================================

    update)
        if [ "$SYSROOT" != "/" ]; then
            die "update only works on the host, not with --sysroot"
        fi

        [ "$EUID" -eq 0 ] ||
            die "updating ports requires root privileges"

        command -v git >/dev/null 2>&1 ||
            die "git is required to update ports"

        load_repos

        UPDATE_WORK=$(mktemp -d "$(dirname "$PORTS_DIR")/.slate-update.XXXXXX") ||
            die "cannot create work directory next to $PORTS_DIR"

        trap cleanup_update EXIT

        NEW_PORTS="$UPDATE_WORK/new"

        mkdir "$NEW_PORTS" ||
            die "cannot create $NEW_PORTS"

        chmod 755 "$NEW_PORTS"

        : > "$NEW_PORTS/.sources"

        shopt -s nullglob

        for i in "${!REPO_URLS[@]}"; do
            url="${REPO_URLS[$i]}"
            tag="${REPO_TAGS[$i]}"
            ref="${REPO_REFS[$i]}"

            dest="$UPDATE_WORK/clone-$i"

            if [[ "${tag,,}" != "testing" ]]; then
                GIT_TERMINAL_PROMPT=0 git ls-remote --exit-code -q --tags -- \
                    "$url" "refs/tags/$ref" </dev/null >/dev/null 2>&1 ||
                    die "no tag '$ref' in $url; existing ports preserved"
            fi

            say "==> Downloading $url ($tag)..."

            if ! GIT_TERMINAL_PROMPT=0 git clone --depth 1 -q \
                --branch "$ref" -- "$url" "$dest" </dev/null; then
                die "failed to download '$tag' from $url; existing ports preserved"
            fi

            commit=$(git -C "$dest" rev-parse --short HEAD 2>/dev/null)

            printf '%s\t%s\t%s\n' "$url" "$tag" "$commit" >> "$NEW_PORTS/.sources"

            for catdir in "$dest"/*/; do
                catdir="${catdir%/}"
                [ -L "$catdir" ] && continue

                cname="${catdir##*/}"

                for pkgdir in "$catdir"/*/; do
                    pkgdir="${pkgdir%/}"

                    [ -L "$pkgdir" ] && continue
                    [ -f "$pkgdir/port.sh" ] || continue
                    [ -f "$pkgdir/meta.conf" ] || continue

                    pname="${pkgdir##*/}"

                    if [ -e "$NEW_PORTS/$cname/$pname" ]; then
                        say "==> Skipping $cname/$pname from $url (provided by an earlier repository)"
                        continue
                    fi

                    mkdir -p "$NEW_PORTS/$cname" &&
                        cp -a -- "$pkgdir" "$NEW_PORTS/$cname/" ||
                        die "failed to copy $cname/$pname from $url; existing ports preserved"
                done
            done

            rm -rf -- "$dest"
        done

        shopt -u nullglob

        say "> Replacing ports directory..."

        OLD_PORTS="$UPDATE_WORK/old"

        if [ -e "$PORTS_DIR" ]; then
            mv -- "$PORTS_DIR" "$OLD_PORTS" ||
                die "failed to move old ports aside; existing ports preserved"
        fi

        if ! mv -- "$NEW_PORTS" "$PORTS_DIR"; then
            [ -e "$OLD_PORTS" ] && mv -- "$OLD_PORTS" "$PORTS_DIR"
            die "failed to install updated ports; previous ports restored"
        fi

        count=$(find "$PORTS_DIR" -mindepth 2 -maxdepth 2 -type f -name port.sh | wc -l)

        say "> Slate ports updated from ${#REPO_URLS[@]} repo(s) ($count ports)."
        ;;

    # ==============================================
    # CHECK FOR NEW REPOSITORY VERSIONS
    # ==============================================

    update-version)
        if [ "$SYSROOT" != "/" ]; then
            die "update-version only works on the host, not with --sysroot"
        fi

        command -v git >/dev/null 2>&1 ||
            die "git is required to check for new versions"

        load_repos

        newer=0
        failed=0

        for i in "${!REPO_URLS[@]}"; do
            url="${REPO_URLS[$i]}"
            tag="${REPO_TAGS[$i]}"
            cur="${tag#v}"

            if [[ "${tag,,}" == "testing" ]]; then
                say "==> $url: tracking 'testing', nothing to compare"
                continue
            fi

            if ! tags=$(GIT_TERMINAL_PROMPT=0 git ls-remote --tags --refs -q -- \
                    "$url" </dev/null 2>/dev/null); then
                say "==> $url: could not reach repository" >&2
                failed=1
                continue
            fi

            latest=$(printf '%s\n' "$tags" |
                sed -n 's|.*refs/tags/v\{0,1\}\([0-9][0-9.]*[0-9]\)$|\1|p' |
                sort -V | tail -n 1)

            if [ -z "$latest" ]; then
                say "==> $url: no version tags found" >&2
                failed=1
                continue
            fi

            if [ "$latest" = "$cur" ]; then
                say "==> $url: up to date ($cur)"
            elif [ "$(printf '%s\n%s\n' "$cur" "$latest" | sort -V | tail -n 1)" = "$latest" ]; then
                say "==> $url: newer release available: $latest (installed: $cur)"
                newer=1
            else
                say "==> $url: installed $cur is newer than the latest tag ($latest)"
            fi
        done

        if [ "$newer" -eq 1 ]; then
            say "> To upgrade, set the new version in $VER_FILE and run: slate update"
            exit 10
        fi

        [ "$failed" -eq 0 ] || exit 1
        ;;

    # ==============================================
    # LIST
    # ==============================================

    list)
        [ -d "$PORTS_DIR" ] || die "ports directory not found"

        if [ -z "$2" ]; then
            for f in "$PORTS_DIR"/*; do
                if [ -d "$f" ] && [ "$f" != "$PORTS_DIR/installed" ]; then
                    basename "$f" | grep -v "^[.]"
                fi
            done

        elif [ -z "$3" ]; then
            case "$2" in
                */*) die "invalid input '$2'" ;;
                installed) die "category '$2' not found" ;;
            esac

            CATEGORY_DIR="$PORTS_DIR/$2"

            [ -d "$CATEGORY_DIR" ] ||
                die "category '$2' not found"

            for f in "$CATEGORY_DIR"/*; do
                if [ -d "$f" ]; then
                    basename "$f" | grep -v "^[.]"
                fi
            done
        else
            die "invalid amount of options"
        fi
        ;;

    *)
        if [ "$INFO" -eq 1 ]; then
            [ -n "$1" ] || usage
            package_info "$1"

        elif [ "$SHOW_DEPS" -eq 1 ]; then
            [ -n "$1" ] || usage
            package_dependencies "$1"

        else
            usage
        fi
        ;;
esac

