#!/bin/sh

start() {
    ip link set eth0 up
    ip link set lo up

    sdhcp eth0

    echo 0 999999999 > /proc/sys/net/ipv4/ping_group_range
}

stop() {
    ip link set eth0 down
    ip link set lo down
}

restart() {
    stop
    start
}

case "$1" in
    start|"") start ;;
    stop) stop ;;
    restart) restart ;;
    *) echo "Usage: $0 {start|stop|restart}" ; exit 1 ;;
esac
