#!/bin/sh

start() {
    # Read directly instead of forking cat(1).
    if IFS= read -r name < /etc/hostname && [ -n "$name" ]; then
        hostname "$name"
    fi
}

stop() {
    hostname localhost
}

restart() {
    stop
    start
}

case "$1" in
    start|"") start ;;
    stop) stop ;;
    restart) restart ;;
    *) echo "Usage: $0 {start|stop|restart}" ; exit 1 ;;
esac
