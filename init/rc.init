#!/bin/sh

PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/sbin
export PATH

# Allow: rc.init start <service>
if [ -n "$2" ]; then
    exec sh "/etc/init.d/$2" "${1:-start}"
fi

spawn() {
    while :; do
        /bin/toybox getty 115200 "$1"
        sleep 1
    done
}

case "${1:-start}" in
    start)
        mount -o remount,rw / 2>/dev/null
        sh /etc/init.d/startfiles start

        # One getty per virtual terminal; they run independently.
        spawn tty1 &
        spawn tty2 &
        spawn tty3 &

        wait
        ;;

    stop)
        sh /etc/init.d/startfiles stop
        ;;

    restart)
        sh /etc/init.d/startfiles restart
        ;;

    *)
        echo "Usage: $0 {start|stop|restart} [service]" >&2
        exit 1
        ;;
esac
