
#!/bin/toybox sh

PATH=/bin
export PATH

# Mount virtual filesystems.
/bin/toybox mkdir -p /proc /sys /dev
/bin/toybox mount -t devtmpfs devtmpfs /dev
/bin/toybox mount -t proc proc /proc
/bin/toybox mount -t sysfs sysfs /sys

# Read root device from kernel command line.
spec=$(/bin/toybox cat /proc/cmdline | /bin/toybox grep -o 'root=[^ ]*')
spec=${spec#root=}

dev=

if [ "${spec#/dev/}" != "$spec" ]; then
    dev=$spec
fi

# Resolve UUID or LABEL.
if [ -z "$dev" ] && [ -n "$spec" ]; then
    case "$spec" in
        UUID=*)
            pattern="UUID=\"${spec#UUID=}\""
            ;;
        LABEL=*)
            pattern="LABEL=\"${spec#LABEL=}\""
            ;;
    esac

    if [ -n "$pattern" ]; then
        dev=$(/bin/toybox blkid 2>/dev/null | /bin/toybox grep -F "$pattern" |
            /bin/toybox cut -d: -f1 | /bin/toybox head -n 1)
    fi
fi

# Ask operator if root device is unavailable.
if [ -z "$dev" ] || [ ! -b "$dev" ]; then
    dev="/dev/$(/bin/choose-root)"
fi

# Mount root and switch.
 /bin/toybox mkdir -p /newroot
/bin/toybox mount -o ro "$dev" /newroot

exec /bin/slate-switch-root /newroot /sbin/init

